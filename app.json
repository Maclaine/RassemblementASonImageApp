{
  "expo": {
    "name": "Rassemblement À Son Image",
    "slug": "rassemblementasonimage",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rassemblementasonimage",
    "userInterfaceStyle": "automatic",
    "ios": {
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.maclaine.rassemblementasonimage"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.maclaine.rassemblementasonimage"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#816F5C",
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "cover"
        }
      ],
      ["expo-audio", { "enableBackgroundPlayback": true }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "da4d5265-1e5b-4d49-9ff8-976d20313dbb"
      }
    },
    "owner": "maclaine"
  }
}
